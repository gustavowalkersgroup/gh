[Unit]
Description=Focus Arena - jogo de foco TDAH (ClickUp + WhatsApp AI)
After=network.target

[Service]
Type=simple
# Ajuste User e WorkingDirectory ao seu ambiente.
User=www-data
Group=www-data
WorkingDirectory=/opt/focus-arena/focus-arena
EnvironmentFile=/etc/focus-arena.env
ExecStart=/usr/bin/node server/webhook-server.js
Restart=on-failure
RestartSec=3

# Hardening básico
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
