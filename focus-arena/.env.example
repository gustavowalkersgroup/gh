# ===== FOCUS ARENA — servidor opcional =====
# Copie para .env (ou exporte direto) antes de rodar o webhook-server.js.

# Porta do servidor (default 4173)
PORT=4173

# Token pessoal do ClickUp (pk_...). Habilita o proxy /api/clickup e o write-back.
# Pegue em: ClickUp > Settings > Apps > API Token
CLICKUP_TOKEN=

# (Opcional) Segredo compartilhado: se definido, sua IA do WhatsApp precisa enviar
# o header  x-fa-secret: <valor>  no POST para /api/whatsapp.
WHATSAPP_SHARED_SECRET=
